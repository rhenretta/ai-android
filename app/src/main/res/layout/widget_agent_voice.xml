<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_pill_bg"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Left Tappable Calm Status Zone (opens workspace) -->
    <LinearLayout
        android:id="@+id/widget_status_zone"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_active" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="All clear"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 48dp Keyboard Shortcut (opens workspace with keyboard immediately focused) -->
    <ImageButton
        android:id="@+id/widget_btn_type"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_btn_secondary"
        android:contentDescription="Type to talk"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_keyboard"
        android:tint="@color/widget_btn_secondary_fg" />

    <!-- 48dp Synchronous Voice Mic / Hangup Button -->
    <ImageButton
        android:id="@+id/widget_btn_voice"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_btn_primary"
        android:contentDescription="Start synchronous voice chat"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic"
        android:tint="@color/widget_btn_primary_fg" />

</LinearLayout>
